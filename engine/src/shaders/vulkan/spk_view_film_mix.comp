#version 450
#extension GL_GOOGLE_include_directive : require
// Shares the actual gate, penumbra, scan registration and pair mapping.
#include "spk_overscan_body.glsl"
layout(binding=4,std430) readonly buffer Print { uint v[]; } film;
layout(binding=5,std430) readonly buffer Strength { float v[]; } strength;
float encode_prophoto(float x) { return x < 1.0/512.0 ? 16.0*x : pow(x,1.0/1.8); }
void main() {
    uint i=gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*gl_WorkGroupSize.x)+gl_GlobalInvocationID.x;
    if(i>=count.v[0]) return;
    uint rg=film.v[2u*i],ba=film.v[2u*i+1u];
    vec3 full=vec3(rg&65535u,rg>>16u,ba&65535u)/65535.0;
    float coverage=1.0;
    vec3 raw;
    if(count.v[4]!=0u) {
        vec2 st=canvas_to_film(float(i%count.v[1]),float(i/count.v[1])),sg=st;
        if(params.v[P_PAIR_ADV]>0.0 && st.x>params.v[P_GS0]+0.5*(params.v[P_GW]+params.v[P_PAIR_ADV])) sg.x-=params.v[P_PAIR_ADV];
        coverage=penumbra(gate_sdf(sg),params.v[P_PENUMBRA]);
        float fx,fy,px=params.v[P_PX];
        if(params.v[P_VERTICAL]<0.5) {fx=(st.x-params.v[P_GS0])/px-0.5;fy=(st.y-params.v[P_GT0])/px-0.5;}
        else {fx=(params.v[P_GT0]+params.v[P_GH]-st.y)/px-0.5;fy=(st.x-params.v[P_GS0])/px-0.5;}
        raw=sample_frame(fx,fy,count.v[2],count.v[3]);
    } else raw=vec3(src.v[3u*i],src.v[3u*i+1u],src.v[3u*i+2u]);
    vec3 base=vec3(encode_prophoto(raw.r),encode_prophoto(raw.g),encode_prophoto(raw.b));
    precise vec3 c=full*(1.0-(1.0-strength.v[0])*coverage)+base*((1.0-strength.v[0])*coverage);
    dst.v[3u*i]=c.r;dst.v[3u*i+1u]=c.g;dst.v[3u*i+2u]=c.b;
}
